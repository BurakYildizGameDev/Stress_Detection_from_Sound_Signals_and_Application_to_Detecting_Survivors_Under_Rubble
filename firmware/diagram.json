{
  "version": 1,
  "author": "Acoustic Survivor Detection",
  "editor": "wokwi",
  "parts": [
    {
      "type": "board-esp32-s3-devkitc-1",
      "id": "esp",
      "top": 0,
      "left": 0,
      "attrs": { "serialInterface": "USB_SERIAL_JTAG" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r1",
      "top": 60,
      "left": 160,
      "rotate": 90,
      "attrs": { "value": "220" }
    },
    {
      "type": "wokwi-led",
      "id": "led_alarm",
      "top": -20,
      "left": 190,
      "attrs": { "color": "red", "label": "ALARM" }
    }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],
    [ "esp:7", "r1:1", "green", [] ],
    [ "r1:2", "led_alarm:A", "green", [] ],
    [ "led_alarm:C", "esp:GND.1", "black", [] ]
  ],
  "dependencies": {}
}
